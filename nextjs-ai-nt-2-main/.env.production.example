# ---------- Database ----------
# MySQL / MariaDB connection string used by Prisma (runtime + migrate deploy).
# Example: mysql://user:password@host:3306/dbname?connection_limit=5&pool_timeout=30
DATABASE_URL=mysql://root:CHANGE_ME@localhost:3306/CHANGE_DB_NAME?connection_limit=5&pool_timeout=30

# ---------- Auth (better-auth) ----------
# Secret used to sign auth tokens. Generate a strong random value:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32

# Public URL of the app (must equal what browsers hit, including port)
BETTER_AUTH_URL=http://localhost:3000